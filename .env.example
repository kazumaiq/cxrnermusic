# ==============================================================================
# CXRNER MUSIC & CXRNER LINK — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production deployment on Vercel:
#   Add these variables in Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DOMAINS & CANONICAL URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://cxrnermusic.com"
NEXT_PUBLIC_LINK_DOMAIN="https://link.cxrnermusic.com"

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Obtain from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. ADMIN ACCESS & SECURITY
# ------------------------------------------------------------------------------
# Comma-separated list of admin email addresses allowed to manage links and submissions
ADMIN_EMAILS="admin@cxrnermusic.com,owner@cxrnermusic.com"

# Master key password for quick admin login
ADMIN_MASTER_KEY="cxrner2026"

# Secret token for Vercel Cron authorization (Bearer <token>)
CRON_SECRET="generate-a-strong-random-secret-key-here"

# ------------------------------------------------------------------------------
# 4. MUSIC STREAMING APIS (OPTIONAL / ENHANCED LOOKUP)
# ------------------------------------------------------------------------------
# Spotify Web API: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT NOTIFICATIONS & PRE-SAVE
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=""
TELEGRAM_MODERATION_CHAT_ID=""

# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFICATIONS (RESEND / SMTP)
# ------------------------------------------------------------------------------
# Resend API Key: https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="CXRNER MUSIC <releases@cxrnermusic.com>"
